# Gemini API key (AI Studio). Chỉ server đọc, không gửi xuống trình duyệt.
GEMINI_API_KEY=
# gemini-3.8-live (khuyến nghị) | gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
# Giới hạn thời gian 1 cuộc gọi (giây) để không tốn phí ngoài ý muốn
MAX_SESSION_SECONDS=480
